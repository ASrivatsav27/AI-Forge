# Node modules — reinstalled clean inside the image
node_modules/

*.pem

# TypeScript build output — rebuilt inside the image
dist/

# Environment files — never baked into the image
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artefacts
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Test output
coverage/
*.test.ts
*.spec.ts

# Docker files (no need to copy them into the image)
Dockerfile
docker-compose.yml
.dockerignore
